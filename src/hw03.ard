-- 3. Докажите ассоциативность ++

\func ++-assoc {A : \Type} (xs ys zs : List A) : (xs ++ ys) ++ zs = xs ++ (ys ++ zs) \elim xs
  | nil => idp
  | a :: xs => pmap (a ::) (++-assoc xs ys zs)

\func sum (xs : List Nat) : Nat
  | nil => 0
  | :: x xs => x + sum xs

-- 4. Докажите, что sum (reverse xs) = sum xs, где reverse определен через ++

\func reverse {A : \Type} (xs : List A) : List A
  | nil => nil
  | :: x xs => reverse xs ++ x :: nil

-- Это утверждение будет полезно для доказательства

\func sum++ (xs ys : List Nat) : sum (xs ++ ys) = sum xs + sum ys \elim xs
  | nil => idp
  | a :: xs =>
    pmap (a +) (sum++ xs ys) *> inv (+-assoc a (sum xs) (sum ys))

\func sum-reverse (xs : List Nat) : sum (reverse xs) = sum xs \elim xs
  | nil => idp
  | a :: xs =>
    sum++ (reverse xs) (a :: nil) *>
    pmap (+ a) (sum-reverse xs) *>
    +-comm (sum xs) a

-- 5. Докажите дистрибутивность умножения над сложением для натуральных чисел

\func rdistr (n m k : Nat) : (m + k) * n = m * n + k * n \elim n
  | 0 => idp
  | suc n =>
    pmap (\lam x => x + (m + k)) (rdistr n m k)
      *> swap-c-d (m * n) (k * n) m k
  \where
    \func swap-c-d (a b c d : Nat) : (a + b) + (c + d) = (a + c) + (b + d) => +-assoc a b (c + d)
      *> pmap (\lam x => a + x)
             (inv (+-assoc b c d)
               *> pmap (\lam x => x + d) (+-comm b c)
                    *> +-assoc c b d)
           *> inv (+-assoc a c (b + d))

\func ldistr (n m k : Nat) : n * (m + k) = n * m + n * k \elim k
  | 0 => idp
  | suc k => pmap (\lam x => x + n) (ldistr n m k) *> +-assoc (n * m) (n * k) n
-- 6. Определите конгруэнтность для функций двух аргументов через transport
--    Можно использовать любые функции, определенные через transport

\func pmap2 {A B C : \Type} (f : A -> B -> C) {a a' : A} (p : a = a') {b b' : B} (q : b = b') : f a b = f a' b' =>
  transport (\lam y => f a b = f a' y) q (transport (\lam x => f a b = f x b) p idp)


-- 7. Докажите, что transport выражается через pmap и repl и наоборот

-- repl говорит, что если у нас есть два равных типа, то у нас есть функция из одного во второй
-- Определите repl через transport

\func repl.{l} {A B : \Type l} (p : A = B) (a : A) : B => transport p (\lam x => x) a

-- Определите transport через repl и pmap

\func transport'.{l} {A : \Type} (B : A -> \Type l) {a a' : A} (p : a = a') (b : B a) : B a'
  => repl (pmap {A} {\Type l} B p) b
